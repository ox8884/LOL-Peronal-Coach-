RIOT_API_KEY=
RIOT_GAME_NAME=
RIOT_TAG_LINE=
RIOT_PLATFORM=kr
# 키 저장 시각 (앱이 자동 기록 — Development 키 24h 만료 안내)
# RIOT_API_KEY_SAVED_AT=
# 선택형 AI 코칭 — OpenAI 호환 /chat/completions API
LOL_COACH_LLM_PROVIDER=custom
# API 버전 경로까지 입력 (예: https://your-server.example/v1). /v1 자동 추가 없음.
# 원격 주소는 HTTPS, HTTP는 localhost/loopback 서버만 허용합니다.
LOL_COACH_LLM_BASE_URL=
# 이 Base URL에 사용할 키. 다른 프로그램의 인증 파일/기존 provider 키는 읽지 않습니다.
LOL_COACH_LLM_KEY=
# 설정 창에서 GET /models 목록을 불러와 선택하거나 모델 ID를 직접 입력합니다.
# 목록 조회를 지원하지 않는 서버도 모델 직접 입력으로 사용할 수 있습니다.
LOL_COACH_LLM_MODEL=
